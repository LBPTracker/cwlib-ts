{
  "name": "@lbptracker/cwlib",
  "version": "0.4.43",
  "type": "module",
  "description": "A TypeScript reader and writer for LittleBigPlanet's serialised resources: LVLb/PLNb containers, the Thing graph, its parts, the saves they arrive in, and the .plan writer.",
  "license": "MIT",
  "exports": {
    "./*.ts": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBPTracker/cwlib-ts.git"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
